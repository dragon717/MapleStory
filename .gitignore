# OS files, Python cache and local tool state.
.DS_Store
__pycache__/
*.pyc
.playwright-cli/
/.trash-icloud-dup/
/.workbuddy/
/.workbuddy-ai/memory/

# Live accounts, credentials, logs, retained releases and temporary builds.
/server/data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
/runtime/
/build/
/client/dist*/

# Installed dependencies and native build caches.
/client/node_modules/
/scripts/node_modules/
/scripts/unpack_tms273_ms/target/
/server/target/
/client/src-tauri/target/

# Third-party source packages and exported runtime resources (distributed separately).
/参考/
/resources/
/client/public/
/client/public-gameplay/
/client/public-tms273/
/references/browser-probe/assets/
/references/gameplay-assets/assets/
/references/gameplay-assets/avatar/assets/
# Large derived map catalog: regenerate with import_tms273.py + export_tms273.cjs.
/references/tms273-data/maps.json
/references/tms273-data/quests.json
/references/tms273-data/manifest.json
MapleStory-运行资源-*.tar.gz

# Local screenshots, art/audio exports and archives.
*.png
*.jpg
*.jpeg
*.gif
*.webm
*.mp4
*.mp3
*.wav
*.wz
*.zip
# Packaged app icons are build inputs, unlike screenshots or icon-source.png.
!/client/src-tauri/icons/*.png

# Recomputable reports. Keep handwritten sources, curated baselines and gate inputs.
/artifacts/**/*.log
/artifacts/henesys/
/artifacts/character-hold/
/artifacts/windbell/
/artifacts/asset-index-report.json
/artifacts/refactor/frontend-deps.json
/artifacts/refactor/large-files.json
/artifacts/portal-boundary-classification.json
/artifacts/portal-closure.json
/artifacts/portal-closure-repro.json
/artifacts/tms273_source_volume_audit.json
/artifacts/tms273_assemble_missing.json
/references/browser-probe/check-results.json
/references/browser-probe/export-summary.json
/references/gameplay-assets/avatar/export-summary.json
/scripts/_probe_skill_outlinks.json
# debt-register.json, baseline-metrics.json, repair ledgers and the canvas-volume
# mapping consumed by _probe_skill_outlinks.cjs intentionally remain versioned.

# Evidence output stays local; handwritten findings, repro scripts and patches stay in Git.
/evidence/**
!/evidence/**/
!/evidence/**/*.md
!/evidence/**/*.cjs
!/evidence/**/*.mjs
!/evidence/**/*.py
!/evidence/**/*.sh
!/evidence/**/*.patch
!/evidence/**/*.diff
