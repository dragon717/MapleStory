.DS_Store
__pycache__/
*.pyc
.playwright-cli/

# Original third-party repositories, WZ packages and acquisition material.
参考/

# Local runtime state and credentials.
server/data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Dependencies and build output.
client/node_modules/
scripts/node_modules/
scripts/unpack_tms273_ms/target/
server/target/

# Generated/runtime resource trees stay in the root resource archive.
client/public/
client/public-gameplay/
client/public-tms273/
references/browser-probe/assets/
references/gameplay-assets/assets/
references/gameplay-assets/avatar/assets/
resources/

# TMS273 map catalog: a 152 MB export derived from the 参考/ WZ packages. It grows
# with every map assembly (98 -> 139 -> 153 MB) and broke GitHub's 100 MB blob
# limit, so it stays local like the generated trees above. Rebuild it through
# scripts/import_tms273.py + scripts/export_tms273.cjs instead of committing it.
references/tms273-data/maps.json

# Evidence media and other binary art/audio are not source commits.
*.png
*.jpg
*.jpeg
*.gif
*.webm
*.mp4
*.mp3
*.wav
*.wz
*.zip
MapleStory-运行资源-*.tar.gz
.workbuddy/*
.workbuddy-ai/memory/*

evidence/*/quest-i18n/cache/*


# Directory policy: release candidates, retained builds and live control are local.
/build/
/runtime/
/client/dist*/

# Desktop shell: Cargo build output for src-tauri（与 server/target 同性质）。
client/src-tauri/target/

# Desktop installer staging area.
build/desktop/

# Content object index report（由 scripts/index_client_assets.cjs --report 生成；
# 权威版本号在 assets/objects/current.json 指针里，这份报告只是可重算的流水）。
artifacts/asset-index-report.json
evidence/*
